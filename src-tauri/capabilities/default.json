{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Nadir",
  "windows": ["main"],
  "webviews": ["chrome", "tab-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:webview:default",
    "core:event:default",
    "shell:allow-open",
    "allow-browser-commands"
  ]
}
